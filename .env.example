# ── 复制成 .env（或直接在部署平台的环境变量里配） ─────────────

# 站点对外地址：验证邮件里的链接用它拼。上线必须改，否则邮件里是 localhost！
PUBLIC_BASE_URL=https://vote.insightedu.io
PORT=4090

# ── 发信通道（三选一） ────────────────────────────────────
# ① Resend（推荐，零依赖、免费额度够用）：https://resend.com
RESEND_API_KEY=
# 域名验证通过前，可以先用 onboarding@resend.dev 发测试信
MAIL_FROM=insightPLAY 票选 <vote@insightedu.io>

# ② SMTP（Gmail / 企业邮箱）—— 要先 npm i nodemailer
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=            # Gmail 用「应用专用密码」，不是登录密码
# SMTP_SECURE=0

# ③ 都不配 = console 模式，验证链接直接打印在终端（只适合本地开发）
# MAIL_PROVIDER=console
# DEV_SHOW_LINK=1       # 本地调试：把验证链接也返回给前端页面

# ── 组织者后台 ────────────────────────────────────────────
# 设了才能访问 /api/admin/results 和 /api/admin/export.csv，用长随机串
ADMIN_KEY=

# ── 可选 ──────────────────────────────────────────────────
REVEAL_RESULTS=0        # 1 = 前端实时公开票数；0 = 计票中保密（推荐）
DATA_DIR=               # 数据文件目录，默认 ./data（部署时指向持久化盘）
IP_SALT=                # IP 哈希盐，随便一串长随机字符
